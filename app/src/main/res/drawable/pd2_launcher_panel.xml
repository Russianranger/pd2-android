<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#29231E" android:endColor="#151312" />
            <stroke android:width="1dp" android:color="#66523B" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="1dp" />
            <gradient android:angle="270" android:startColor="#211D1A" android:endColor="#171514" />
            <stroke android:width="1dp" android:color="#322C25" />
        </shape>
    </item>
</layer-list>
