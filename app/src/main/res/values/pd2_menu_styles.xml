<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, even when the general Winlator preference uses its light theme. -->
    <style name="Pd2QuickMenuTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">#1B1514</item>
        <item name="android:windowBackground">@drawable/pd2_dialog_background</item>
        <item name="android:textColorPrimary">#F4EADF</item>
        <item name="android:textColorSecondary">#C5B7A9</item>
        <item name="android:textColor">#F4EADF</item>
        <item name="colorAccent">#E2B966</item>
        <item name="android:colorAccent">#E2B966</item>
        <item name="colorControlNormal">#C5B7A9</item>
        <item name="colorControlActivated">#E2B966</item>
        <item name="colorControlHighlight">#604E3524</item>
        <item name="android:listSelector">@drawable/pd2_menu_selection</item>
        <item name="buttonBarPositiveButtonStyle">@style/Pd2QuickMenuButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Pd2QuickMenuButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Pd2QuickMenuButton</item>
    </style>

    <style name="Pd2QuickMenuButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">#E2B966</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
