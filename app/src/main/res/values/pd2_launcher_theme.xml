<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="pd2_launcher_black">#0B0A0A</color>
    <color name="pd2_launcher_surface">#1A1715</color>
    <color name="pd2_launcher_bone">#E9DFCC</color>
    <color name="pd2_launcher_muted">#B8AA96</color>
    <color name="pd2_launcher_gold">#D5B47A</color>
    <color name="pd2_launcher_border">#514434</color>

    <style name="Pd2LauncherTheme" parent="AppThemeDark">
        <item name="android:windowBackground">@drawable/pd2_launcher_background</item>
        <item name="android:colorBackground">@color/pd2_launcher_black</item>
        <item name="android:statusBarColor">@color/pd2_launcher_black</item>
        <item name="android:navigationBarColor">@color/pd2_launcher_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/pd2_launcher_bone</item>
        <item name="android:textColorSecondary">@color/pd2_launcher_muted</item>
        <item name="colorPrimary">@color/pd2_launcher_surface</item>
        <item name="colorPrimaryDark">@color/pd2_launcher_black</item>
        <item name="colorAccent">@color/pd2_launcher_gold</item>
        <item name="colorControlNormal">@color/pd2_launcher_muted</item>
        <item name="colorControlActivated">@color/pd2_launcher_gold</item>
        <item name="colorPrimaryText">@color/pd2_launcher_bone</item>
        <item name="colorSecondaryText">@color/pd2_launcher_muted</item>
        <item name="colorPrimarySurface">@color/pd2_launcher_surface</item>
        <item name="colorSecondarySurface">#211D1A</item>
        <item name="colorPrimaryVariant">#403126</item>
        <item name="colorSecondaryVariant">#302820</item>
        <item name="alertDialogTheme">@style/Pd2LauncherDialogTheme</item>
    </style>

    <style name="Pd2LauncherDialogTheme" parent="Pd2QuickMenuTheme">
        <item name="android:windowBackground">@drawable/pd2_launcher_panel</item>
        <item name="android:colorBackground">@color/pd2_launcher_surface</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">@color/pd2_launcher_bone</item>
        <item name="android:textColorSecondary">@color/pd2_launcher_muted</item>
        <item name="android:textColor">@color/pd2_launcher_bone</item>
        <item name="colorAccent">@color/pd2_launcher_gold</item>
        <item name="android:colorAccent">@color/pd2_launcher_gold</item>
        <item name="colorControlNormal">@color/pd2_launcher_muted</item>
        <item name="colorControlActivated">@color/pd2_launcher_gold</item>
        <item name="colorControlHighlight">#405F492C</item>
        <item name="buttonBarPositiveButtonStyle">@style/Pd2LauncherDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Pd2LauncherDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Pd2LauncherDialogButton</item>
    </style>

    <style name="Pd2LauncherDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/pd2_launcher_gold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
